{
  "manifest_version": 3,
  "name": "Monaco Viewer",
  "version": "0.1.0",
  "description": "Beautiful code viewer powered by Monaco Editor",
  "permissions": ["webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
